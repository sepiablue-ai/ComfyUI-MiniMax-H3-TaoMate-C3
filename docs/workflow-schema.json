  "H3MemoryOptimization": {
    "input": {
      "required": {
        "model": [
          "MODEL",
          {}
        ],
        "fused_qkv": [
          "COMBO",
          {
            "display_name": "Legacy QKV projection optimization",
            "advanced": true,
            "hidden": true,
            "tooltip": "Legacy serialized workflow slot. The value is ignored; QKV streaming is authoritative.",
            "default": "auto",
            "multiselect": false,
            "options": [
              "auto",
              "off"
            ]
          }
        ],
        "mlp_memory": [
          "COMBO",
          {
            "display_name": "MLP memory optimization",
            "tooltip": "auto applies the selected precision policy while retaining bounded MLP chunking. Explicit off remains off.",
            "default": "auto",
            "multiselect": false,
            "options": [
              "auto",
              "off"
            ]
          }
        ],
        "chunk_rows": [
          "INT",
          {
            "display_name": "Activation chunk rows",
            "tooltip": "Maximum token rows processed by one MLP or FinalLayer chunk. Larger chunks may be faster but use more activation memory. The displayed range and step are recommendations; any positive workflow value is accepted. At or above the current input length, the ordinary unsliced MLP runs for that invocation.",
            "advanced": true,
            "default": 4096,
            "min": 256,
            "max": 65536,
            "step": 256
          }
        ],
        "preserve_precision": [
          "BOOLEAN",
          {
            "advanced": true,
            "hidden": true,
            "tooltip": "Legacy serialized workflow slot. The value is ignored; Precision mode is authoritative.",
            "default": true
          }
        ],
        "precision_mode": [
          "COMBO",
          {
            "display_name": "Precision mode",
            "tooltip": "Auto selects the best compatible native path and may use FP8 conversion as a fallback. BF16 materializes supported weights as BF16. Preserve native never introduces a new conversion. Force quant keeps supported quantized checkpoints native and converts floating H3 linears to execution-scoped ConvRot-256 INT8.",
            "advanced": true,
            "default": "Auto",
            "multiselect": false,
            "options": [
              "Auto",
              "BF16",
              "Preserve native",
              "Force quant"
            ]
          }
        ],
        "qkv_streaming_mode": [
          "COMBO",
          {
            "display_name": "QKV streaming",
            "tooltip": "Off prevents this node from replacing existing dense attention and disables QKV streaming, including carriers requested by H3 Sparse Attention. Auto preserves Sage, Comfy Kitchen, or ComfyUI's normal attention selection and adds a compatible bounded carrier; unknown overrides keep their full-Q single-call contract. Forced explicitly allows this node to replace dense attention with full-density Kitchen. H3 Sparse Attention remains authoritative.",
            "advanced": true,
            "default": "Auto",
            "multiselect": false,
            "options": [
              "Off",
              "Auto",
              "Forced"
            ]
          }
        ],
        "embedding_memory_mode": [
          "COMBO",
          {
            "display_name": "Legacy embedding memory",
            "advanced": true,
            "hidden": true,
            "tooltip": "Legacy serialized workflow slot. The value is ignored; compatible embedding assembly tensors are released early, otherwise ComfyUI's stock lifetime is preserved.",
            "default": "Auto",
            "multiselect": false,
            "options": [
              "Auto",
              "Stock",
              "Release early"
            ]
          }
        ],
        "kitchen_v_memory_mode": [
          "COMBO",
          {
            "display_name": "Attention memory mode",
            "tooltip": "Standard prioritizes speed. Lower VRAM uses additional attention work to reduce peak memory.",
            "advanced": true,
            "default": "Standard",
            "multiselect": false,
            "options": [
              "Standard",
              "Lower VRAM (slower)"
            ]
          }
        ]
      }
    },
    "output": [
      "MODEL"
    ],
    "output_name": [
      "MODEL"
    ]
  },
  "H3SparseAttention": {
    "input": {
      "required": {
        "model": [
          "MODEL",
          {}
        ],
        "video_budget": [
          "FLOAT",
          {
            "display_name": "Video attention budget",
            "tooltip": "Controls the speed/quality tradeoff for target-video attention. Lower values are faster but retain fewer video attention connections and can reduce prompt adherence, change motion/detail, or otherwise change the result. There is no universally safe value: some prompts tolerate very low budgets while others require substantially more. The request rounds up to whole KV tiles; non-video context and mixed boundary tiles stay dense. 1.0 retains the full video route. The displayed range is the recommended editing range; finite workflow values outside it saturate to at least one or at most all video tiles.",
            "default": 0.15,
            "min": 0.01,
            "max": 1.0,
            "step": 0.01
          }
        ],
        "denser_early_late_steps": [
          "BOOLEAN",
          {
            "display_name": "Denser Early ramp",
            "tooltip": "Starts at no less than 50% video attention, then gradually reduces toward the selected budget. The ramp targets 12 additional percentage points per sampler step on average. Budgets already at or above 50% are unchanged.",
            "default": true
          }
        ]
      }
    },
    "output": [
      "MODEL"
    ],
    "output_name": [
      "MODEL"
    ]
  },
